<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find my_arm_description)/urdf/carbot/common_inertia.xacro" />
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <gazebo reference="${wheel_name}_wheel_link">
            <!-- 物理属性设置 -->
            <mu1 value="1.0" />
            <mu2 value="1.0" />
            <kp value="1000000.0" />
            <kd value="100.0" />
            <fdir1>1 0 0</fdir1>
        </gazebo>
        <link name="${wheel_name}_wheel_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0" />
                <geometry>
                    <cylinder length="0.04" radius="0.032" />
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8" />
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0" />
                <geometry>
                    <cylinder length="0.04" radius="0.032" />
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.032" h="0.04" />
        </link>

        <joint name="${wheel_name}_wheel_joint" type="continuous">
            <parent link="base_link" />
            <child link="${wheel_name}_wheel_link" />
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />
            <axis xyz="0 1 0" />
            <!-- 关节物理属性 -->
            <gazebo>
                <damping value="0.1" />
                <friction value="0.01" />
            </gazebo>
        </joint>
    </xacro:macro>
</robot>
